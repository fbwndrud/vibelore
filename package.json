{
  "name": "vibelore",
  "version": "0.4.0",
  "type": "module",
  "description": "Local novel-writing and webtoon-adaptation plugin with continuity checks, storyboards, lettering, and approval workflows.",
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "skills/",
    "src/",
    "engine/src/",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.es.md",
    "README.fr.md",
    "README.zh-Hant.md",
    "README.th.md",
    "README.ar.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "examples/work.gitignore",
    "HOSTS.md",
    "HOSTS.en.md",
    "docs/README.md",
    "docs/README.en.md",
    "docs/PHILOSOPHY.md",
    "docs/PHILOSOPHY.en.md",
    "docs/GETTING_STARTED.md",
    "docs/GETTING_STARTED.en.md",
    "docs/MODELS.md",
    "docs/MODELS.en.md",
    "docs/MCP.md",
    "docs/MCP.en.md",
    "docs/TOOLS.md",
    "docs/TOOLS.en.md",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.en.md",
    "docs/OPERATIONS.md",
    "docs/OPERATIONS.en.md",
    "docs/WEBTOON.md",
    "docs/WEBTOON.en.md",
    "docs/TROUBLESHOOTING.md",
    "docs/TROUBLESHOOTING.en.md",
    "docs/reference/WEBTOON_WORKFLOW.md",
    "docs/reference/WEBTOON_WORKFLOW.en.md",
    "docs/MULTILINGUAL_PLAN.md",
    "hosts/",
    "engine/package.json",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "docs/release-review.json"
  ],
  "bin": {
    "vibelore-mcp": "src/server.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:engine": "cd engine && node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "test:all": "npm run test:engine && npm test",
    "check:source": "node scripts/check-source.js",
    "check:release": "node scripts/check-release.js"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fbwndrud/vibelore.git"
  },
  "homepage": "https://github.com/fbwndrud/vibelore",
  "bugs": "https://github.com/fbwndrud/vibelore/issues"
}
